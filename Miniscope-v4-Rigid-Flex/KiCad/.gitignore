# ==========================================================
# KiCad 6/7/8/9 Gitignore
# ==========================================================

# --- Temporary & Backup Files ---
*.000
*.bak
*.bck
*.kicad_pro-bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# --- Specific Project Backups ---
# Explicitly ignoring the backup folder
Miniscope-v4-Rigid-Flex-backups/

# --- Netlist & Intermediate Files ---
*.net
*.xml
*.dsn
*.ses

# --- Hardware/OS Specific ---
.ipynb_checkpoints/
__pycache__/
*.pyc

# --- Production & Automation ---
# Ignoring KiBot outputs and letting in general plot directories
kibot/
#plots/
#gerbers/
#outputs/

# --- Local Settings ---
# This contains local window state and shouldn't be tracked
*.kicad_prl